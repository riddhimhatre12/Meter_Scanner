# ─── Meter Scanner Pro — Environment Configuration ───────────────────────────
#
# Copy this file to .env and fill in your values.
# Then run: python run.py  (or: set the vars and run app.py)
#
# Google OAuth credentials (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Flask secret key (change this to a random string in production)
SECRET_KEY=change-this-to-a-random-secret-in-production

# Optional: path to Tesseract OCR binary (if not in PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
